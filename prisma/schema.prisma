generator client {
  provider = "prisma-client-js"
}

// Appen bruker DATABASE_URL (Neons pooler). Migreringer (prisma migrate,
// også i build) går over den direkte forbindelsen, siden pooleren ikke
// støtter alt migrate trenger. Begge settes av Neon-integrasjonen i Vercel.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// Spillerregisteret er separat per serie (avklart 2026-09-14) - samme
// person må registreres på nytt i hver serie den deltar i.
model Spiller {
  id          String       @id @default(cuid())
  navn        String
  serieId     String
  serie       Serie        @relation(fields: [serieId], references: [id], onDelete: Cascade)
  opprettet   DateTime     @default(now())
  deltakelser Deltakelse[]

  @@unique([serieId, navn])
}

// Klubbene er helt adskilt fra hverandre (klubbskille, 2026-10-18): egen
// offentlig side på /[slug], egen admin og egne data. Kun Serie har
// klubbId - Spiller, Runde, Deltakelse og RundeEndring nås alltid via
// serien, så klubbfilteret går gjennom den (se lib/data/).
model Klubb {
  id        String       @id @default(cuid())
  navn      String       @unique
  slug      String       @unique
  opprettet DateTime     @default(now())
  serier    Serie[]
  admins    KlubbAdmin[]
}

// Innlogging (2026-10-18). Superadmin oppretter klubber og klubbadmins
// på /superadmin, og kan i tillegg logge inn i hvilken som helst klubb.
model AdminBruker {
  id           String       @id @default(cuid())
  epost        String       @unique
  passordHash  String
  erSuperadmin Boolean      @default(false)
  opprettet    DateTime     @default(now())
  klubber      KlubbAdmin[]
}

// rolle: "admin" | "demo". Demo-admin kan redigere data, men ikke bytte
// passord eller opprette brukere.
model KlubbAdmin {
  brukerId  String
  bruker    AdminBruker @relation(fields: [brukerId], references: [id], onDelete: Cascade)
  klubbId   String
  klubb     Klubb       @relation(fields: [klubbId], references: [id], onDelete: Cascade)
  rolle     String      @default("admin")
  opprettet DateTime    @default(now())

  @@id([brukerId, klubbId])
  @@index([klubbId])
}

model Serie {
  id                   String   @id @default(cuid())
  navn                 String
  ukedager             String // kommaseparert, f.eks. "mandag,onsdag" - kun til visning
  sesongStart          DateTime
  sesongSlutt          DateTime?
  poengGrense          Int      @default(13)
  antallTellendeRunder Int      @default(12)
  status               String   @default("aktiv") // "aktiv" | "avsluttet"
  opprettet            DateTime @default(now())
  klubbId              String
  klubb                Klubb    @relation(fields: [klubbId], references: [id], onDelete: Cascade)
  runder               Runde[]
  spillere             Spiller[]

  @@unique([klubbId, navn])
}

model Runde {
  id           String         @id @default(cuid())
  serieId      String
  serie        Serie          @relation(fields: [serieId], references: [id], onDelete: Cascade)
  dato         DateTime
  rundenummer  Int
  deltakelser  Deltakelse[]
  endringer    RundeEndring[]
  opprettet    DateTime       @default(now())

  @@unique([serieId, rundenummer])
}

// Endringslogg: én rad per gang en admin retter en allerede lagret runde.
// forrigeData er en JSON-snapshot av deltakelser-raden(e) slik de var
// FØR denne endringen, for etterprøvbarhet. kommentar er valgfri.
model RundeEndring {
  id          String   @id @default(cuid())
  rundeId     String
  runde       Runde    @relation(fields: [rundeId], references: [id], onDelete: Cascade)
  tidspunkt   DateTime @default(now())
  kommentar   String?
  forrigeData String

  @@index([rundeId])
}

// En rad = én spillers resultat i én runde. Runden opprettes i databasen
// først når admin sender inn det fullstendige skjemaet for kvelden (§4.5
// i spec: alt-eller-ingenting, ingen delvis lagring) - selve Runde-raden
// og alle Deltakelse-rader lagres derfor i samme transaksjon.
model Deltakelse {
  id        String  @id @default(cuid())
  spillerId String
  spiller   Spiller @relation(fields: [spillerId], references: [id])
  rundeId   String
  runde     Runde   @relation(fields: [rundeId], references: [id], onDelete: Cascade)

  // Null = spilleren fikk ikke spilt denne kampen (avklart 2026-10-13),
  // ikke et tap - minst én av de tre må være satt for at deltakelsen
  // skal gi mening.
  kamp1 Int? // signert poengforskjell, positiv = vant
  kamp2 Int?
  kamp3 Int?

  @@unique([spillerId, rundeId])
}
